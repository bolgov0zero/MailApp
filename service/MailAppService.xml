<service>
  <id>MailAppUpdater</id>
  <name>MailApp Update Service</name>
  <description>Устанавливает обновления MailApp от имени системы без запроса прав администратора.</description>

  <!-- Run the bundled Electron binary as a plain Node process (no GUI). -->
  <executable>%BASE%\..\..\MailApp.exe</executable>
  <env name="ELECTRON_RUN_AS_NODE" value="1"/>
  <arguments>"%BASE%\update-service.js"</arguments>

  <!-- LocalSystem (default for WinSW services) so it can write Program Files. -->
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec"/>

  <log mode="roll-by-size">
    <sizeThreshold>1024</sizeThreshold>
    <keepFiles>2</keepFiles>
  </log>
</service>
